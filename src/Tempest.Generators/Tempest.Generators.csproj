<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Compiler\Tempest.Compiler.csproj" />
    <ProjectReference Include="..\Tempest.Emit\Tempest.Emit.csproj" />
    <ProjectReference Include="..\Tempest.Parsing\Tempest.Parsing.csproj" />
    <ProjectReference Include="..\Tempest.Pipeline\Tempest.Pipeline.csproj" />
    <ProjectReference Include="..\parsers\Tempest.CSharpParser\Tempest.CSharpParser.csproj" />
    <ProjectReference Include="..\parsers\Tempest.RazorParser\Tempest.RazorParser.csproj" />
  </ItemGroup>

</Project>
