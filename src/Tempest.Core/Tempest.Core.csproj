<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tempest</RootNamespace>
    <PackageId>Tempest.Core</PackageId>
    <Version>1.0.0-beta.4</Version>
    <Description>Platform-neutral core for Tempest: the [Command]/[Reactive]/[Event] attributes and the event bus contract. UI hosts (Tempest.Blazor today, Tempest.WinUI later) build on this.</Description>
    <Authors>andresitomanuel</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>..\..\artifacts</PackageOutputPath>
    <PackageTags>blazor;winui;state;state-management;source-generator;events</PackageTags>
  </PropertyGroup>

</Project>
