<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tempest.Wpf\Tempest.Wpf.csproj" />
  </ItemGroup>

  <!-- The Tempest source generator and every pipeline library it loads, referenced as
       analyzers so they ride inside the compiler process. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tempest.Generators\Tempest.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Tempest.Pipeline\Tempest.Pipeline.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Tempest.Parsing\Tempest.Parsing.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\parsers\Tempest.CSharpParser\Tempest.CSharpParser.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\parsers\Tempest.RazorParser\Tempest.RazorParser.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Tempest.Compiler\Tempest.Compiler.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Tempest.Emit\Tempest.Emit.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
