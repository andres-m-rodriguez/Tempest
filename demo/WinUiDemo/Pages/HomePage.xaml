<Page x:Class="WinUiDemo.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WinUiDemo.Controls">
    <ScrollViewer>
        <StackPanel Margin="24"
                    Spacing="12"
                    MaxWidth="520">
            <controls:Counter/>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="The publishers — no reference to the Counter, just the bus"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Click="BumpOneClicked"
                                Content="+1"/>
                        <Button Click="BumpFiveClicked"
                                Content="+5"/>
                        <Button Click="Substract"
                                Content="-1"/>
                        <Button Click="ZeroClicked"
                                Content="Reset"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
