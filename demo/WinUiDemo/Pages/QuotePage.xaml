<tempest:StatefulPage x:Class="WinUiDemo.Pages.QuotePage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:tempest="using:Tempest">
    <StackPanel Margin="24" Spacing="12" MaxWidth="520">
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="StatefulPage: primary-constructor DI + [Command, RunOnLoad]"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding QuoteText}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind LoadState}"
                            Content="{Binding LoadLabel}"/>
                    <Button Click="DetailsClicked"
                            Content="Analyze (navigate with parameter)"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="[Event] — published from outside the page"
                           FontWeight="SemiBold"/>
                <Button Click="RingDoorbellClicked"
                        Content="Ask for a quote via the event bus"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="[Reactive] + [OnChanged] + [CanExecute]"
                           FontWeight="SemiBold"/>
                <TextBox PlaceholderText="Notes about this quote"
                         TextChanged="NotesChanged"
                         Text="{Binding NotesState.Value, Mode=OneWay}"/>
                <TextBlock Text="{Binding NotesSummary}"
                           Opacity="0.6"
                           FontSize="12"/>
                <Button Command="{x:Bind ClearNotesState}"
                        Content="Clear notes"/>
            </StackPanel>
        </Border>
    </StackPanel>
</tempest:StatefulPage>
