<Window x:Class="WinUiDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempest WinUI demo">
    <!-- The shell: a NavigationView over one Frame. Every page it navigates to is a
         StatefulPage — activated through the generated bridge, never newed up here. -->
    <NavigationView x:Name="Nav"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Visible"
                    BackRequested="BackRequested"
                    SelectionChanged="NavChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Component" Tag="home" IsSelected="True"/>
            <NavigationViewItem Content="Quotes" Tag="quotes"/>
        </NavigationView.MenuItems>
        <Frame x:Name="PageHost" Navigated="PageNavigated"/>
    </NavigationView>
</Window>
