<tempest:StatefulControl x:Class="WinUiDemo.Controls.TempestDemoControl"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:tempest="using:Tempest">
    <StackPanel Spacing="12">
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="[Reactive] + [OnChanged]" FontWeight="SemiBold" />
                <TextBox PlaceholderText="Your name" TextChanged="NameChanged" />
                <TextBlock Text="{Binding Greeting}" />
                <TextBlock Text="{Binding DirtyText}" Opacity="0.6" FontSize="12" />
            </StackPanel>
        </Border>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="[Reactive] counter" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding CountState.Value}" FontSize="28" VerticalAlignment="Center" />
                    <Button Click="IncrementClicked" Content="+1" />
                    <Button Click="ResetClicked" Content="Reset" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="[Command]" FontWeight="SemiBold" />
                <Button Click="SaveClicked" Content="{Binding SaveLabel}" IsEnabled="{Binding SaveEnabled}" />
                <TextBlock Text="{Binding SavedAtText}" Opacity="0.6" />
            </StackPanel>
        </Border>
    </StackPanel>
</tempest:StatefulControl>
