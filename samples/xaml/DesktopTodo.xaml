<UserControl
    x:Class="Tempest.Samples.Desktop.DesktopTodo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tempest.Samples.Desktop">

    <StackPanel Spacing="8">
        <TextBox Text="{x:Bind NewTitleState.Value, Mode=TwoWay}"
                 PlaceholderText="What needs doing?" />

        <!-- CommandState is an ICommand: binds Execute + disables while IsLoading -->
        <Button Content="Add" Command="{x:Bind AddState}" />

        <ProgressRing IsActive="{x:Bind LoadState.IsLoading, Mode=OneWay}" />
        <TextBlock Text="{x:Bind LoadState.Error.Message, Mode=OneWay}"
                   Visibility="{x:Bind LoadState.IsError, Mode=OneWay}"
                   Foreground="Red" />

        <ItemsControl ItemsSource="{x:Bind TodosState.Value, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TodoItem">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Title}" />
                        <Button Content="Done" Click="CompleteClicked" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
