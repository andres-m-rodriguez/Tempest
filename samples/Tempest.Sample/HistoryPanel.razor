@* Regression coverage for two generator fixes:
   1. [Reactive] fields typed with a PRIVATE nested type — the generated state property
      matches the field's accessibility, so no CS0053.
   2. Field types that only resolve via a @using (DateRange below) — the generated file
      carries this file's @using directives, so no CS0246. *@
@using Tempest.Sample.Widgets
@inherits StatefulComponent

<p>Sorted: @_sort — range set: @(_range is not null)</p>

@code {
    private enum HistorySort { Newest, Oldest }

    [Reactive]
    private HistorySort _sort = HistorySort.Newest;

    [Reactive]
    private DateRange? _range;

    private partial void OnSortChanged(HistorySort value) => _ = value;
}
