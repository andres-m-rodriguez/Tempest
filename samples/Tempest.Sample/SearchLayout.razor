@* Regression coverage: layouts get the full Tempest treatment via StatefulLayoutComponent —
   here the classic global-search-in-the-header, with latest-wins cancellation for free. *@
@inherits StatefulLayoutComponent

<header>
    <input type="search" @bind="QueryState.Value" @bind:event="oninput" placeholder="Search everywhere…" />
    @if (SearchEverywhereState.IsLoading)
    {
        <em>searching…</em>
    }
</header>

<main>
    @Body
</main>

@code {
    [Reactive]
    private string _query = "";

    private partial Task OnQueryChanged(string value) => SearchEverywhereState.TryExecute();

    [Command]
    private async Task<List<string>> SearchEverywhere(CancellationToken ct)
    {
        await Task.Delay(200, ct);
        return [$"result for '{_query}'"];
    }
}
